# Reference only: Node does not read this file automatically.
# Set these in your terminal (see README, step 2).
GEMINI_API_KEY=replace-me
# Model IDs change over time: https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-flash-lite-latest
JUDGE_MODEL=gemini-flash-latest
EMBEDDER_MODEL=gemini-embedding-001
PROMPT_VERSION=v1
GUARD=on
JUDGE_MIN_PASS_RATE=0.8
